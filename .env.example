# Modelo do arquivo .env.local, que guarda as configurações (e, no futuro, as chaves) desta máquina.
# Para usar: copie este arquivo com o nome .env.local e preencha os valores.
# O .env.local nunca vai para o Git. Aqui ficam só os nomes das variáveis, nunca valores secretos.

# Só para testes com a IA simulada: faz IAs falharem de propósito, para ver as novas tentativas e a troca de IA.
#   gpt            o GPT falha sempre (o Claude assume o papel de Programador)
#   gpt:2          o GPT falha nas 2 primeiras tentativas de cada etapa e acerta na 3ª
#   gemini,claude  o Gemini e o Claude falham sempre (o GPT assume o papel de Chefe, e o time para no Revisor)
# Vazio: nenhuma IA falha. O npm run dev percebe a mudança sozinho ao salvar (no terminal: "Reload env").
MOCK_AI_FAILURES=

# Chaves das IAs, criadas no site de cada empresa. Ficam só no .env.local: nunca no código, no chat ou em mensagens.
# A partir da T9, a IA que estiver sem chave continua simulada.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OCK — chaves-MÃE da plataforma (uma por IA). TODA empresa usa estas; a OCK mede e trava por empresa/funcionário.
# A empresa nunca conecta nem vê chave. Ficam só no servidor (env do Vercel). Sem uma delas, aquela IA roda simulada.
OCK_CLAUDE_KEY=
OCK_GPT_KEY=
OCK_GEMINI_KEY=

# Supabase: guarda a execução para ela sobreviver ao navegador sair e continuar entre chamadas curtas do servidor.
# A URL e a chave pública (anon) também vão para o navegador; a chave de serviço NUNCA sai do servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hex de 32 bytes (64 caracteres): criptografa as chaves de API do usuário em repouso (AES-256-GCM).
RUN_KEY_SECRET=

# Protege a rota interna /api/runs/[id]/continue, que o servidor chama em si mesmo para seguir a execução.
INTERNAL_RUN_SECRET=
