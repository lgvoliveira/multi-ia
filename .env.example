# Modelo do arquivo .env.local, que guarda as configurações (e, no futuro, as chaves) desta máquina.
# Para usar: copie este arquivo com o nome .env.local e preencha os valores.
# O .env.local nunca vai para o Git. Aqui ficam só os nomes das variáveis, nunca valores secretos.

# Visão raio-x: SÓ no computador. Com OCK_DEMO_MODE=1, a tela inicial e o topo ganham um atalho para entrar como Chefe
# ou como Funcionário com um clique (usa as contas do seed, já com crédito), sem login, e-mail nem crédito. Serve para
# passear pelo site inteiro dos dois lados. NUNCA ligar no Vercel: de todo jeito o código só ativa fora de produção.
# Vazio/ausente: desligado (o padrão).
OCK_DEMO_MODE=

# Só para testes com a IA simulada: faz IAs falharem de propósito, para ver as novas tentativas e a troca de IA.
#   gpt            o GPT falha sempre (o Claude assume o papel de Programador)
#   gpt:2          o GPT falha nas 2 primeiras tentativas de cada etapa e acerta na 3ª
#   gemini,claude  o Gemini e o Claude falham sempre (o GPT assume o papel de Chefe, e o time para no Revisor)
# Vazio: nenhuma IA falha. O npm run dev percebe a mudança sozinho ao salvar (no terminal: "Reload env").
MOCK_AI_FAILURES=

# Só para testes com a IA simulada: faz IAs "gastarem" além do previsto (dizem ter escrito 10 vezes o limite da
# etapa), para ver o time pausar e perguntar se continua.
#   claude         o Claude gasta demais; com o time recomendado, a pausa vem logo depois do plano do Chefe
#   claude,gpt     o Claude e o GPT gastam demais
# No chat não há pausa: a mensagem é cobrada pelo que a IA disse ter gastado (passa da reserva, F29).
# Vazio: ninguém gasta além do previsto.
MOCK_AI_OVERSPEND=

# Qual IA responde nas receitas e no chat (F42):
#   simulada   todas simuladas: respostas de mentira, sem chamar nenhuma empresa, cobradas da carteira como se fossem
#              de verdade (para testar a cobrança sem gastar nada)
#   real       as IAs de verdade, com as chaves abaixo. A que estiver sem chave FALHA (nas receitas, outra IA assume o
#              papel); nunca vira a simulada sem avisar
# Vazio: simulada no computador (npm run dev) e real no site publicado. O npm run dev percebe a mudança ao salvar.
OCK_AI_MODE=

# Ferramentas das IAs, ligadas uma a uma, separadas por vírgula (vazio: nenhuma, o padrão):
#   pesquisa   pesquisar na internet e citar as fontes (quem pesquisa é o Claude; US$ 0,01 por pesquisa, até 3 por mensagem)
#   codigo     rodar um programa para fazer contas (quem roda é o Gemini; sem custo além dos tokens)
#   imagem     criar imagens (quem cria é o GPT Image; uns US$ 0,053 por imagem quadrada de qualidade média)
#   voz        ditar a mensagem no chat (quem transcreve é o gpt-transcribe; US$ 0,0045 por minuto, até 2 minutos)
# Com OCK_AI_MODE=simulada, as ferramentas ligadas são fingidas (uma fonte de exemplo, um quadriculado no lugar da
# imagem, um texto de exemplo no lugar do ditado), para testar a tela sem gastar.
OCK_AI_TOOLS=

# Chaves das IAs de verdade (uma por empresa), criadas no site de cada uma: passo a passo em docs/GUIA-TESTE-IAS-REAIS.md.
# Toda empresa cliente usa estas; a OCK mede e trava por empresa e por funcionário. Ficam só no .env.local (e, no site
# publicado, nas variáveis de ambiente da Vercel): nunca no código, no chat ou em mensagens. Só valem com OCK_AI_MODE=real.
OCK_CLAUDE_KEY=
OCK_GPT_KEY=
OCK_GEMINI_KEY=

# Supabase: login, banco e arquivos. Neste computador, sempre o PROJETO DE TESTES (multi-ia-teste), nunca o de verdade
# (docs/BANCO-DE-DADOS.md, "Projeto de testes"). No painel do projeto: Connect → App Frameworks → Next.js mostra as
# duas primeiras; a terceira fica em Project Settings → API Keys → Secret keys.
# A URL e a chave pública (publishable, começa com sb_publishable_) também vão para o navegador.
# A chave secreta (começa com sb_secret_) passa por cima das regras de acesso: NUNCA sai do servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# (A rota interna /api/runs/[id]/continue usa um segredo tirado da SUPABASE_SECRET_KEY: não há variável a mais.)
